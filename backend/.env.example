# Application Settings
PROJECT_NAME="Patient Glucose Monitoring & AI Reporting System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Configuration
DATABASE_URL="sqlite+aiosqlite:///./data/patients.db"

# LLM Configuration
LLM_PROVIDER="openai" # options: openai, google, mock
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
GOOGLE_API_KEY="your-google-api-key"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@hospital-care.org"
SMTP_PASSWORD="app-password-placeholder"
EMAILS_FROM_EMAIL="notifications@hospital-care.org"
EMAILS_FROM_NAME="Hospital Glucose Monitoring Center"
EMAIL_ENABLED=false # set to true when credentials are active

# Glucose Stage Thresholds (mg/dL)
# Hypoglycemia: < 70
# Normal: 70 - 99
# Pre-diabetes: 100 - 125
# Diabetes: >= 126
GLUCOSE_HYPO_THRESHOLD=70.0
GLUCOSE_NORMAL_MAX=99.0
GLUCOSE_PREDIABETES_MAX=125.0
